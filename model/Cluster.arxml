                </TIMING-EVENT>
              </EVENTS>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>Runnable_DriverInput_10ms</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <DATA-SEND-POINTS>
                      <VARIABLE-ACCESS>
                        <SHORT-NAME>DSP_Pedal_Throttle</SHORT-NAME>
                        <ACCESSED-VARIABLE>
                          <AUTOSAR-VARIABLE-IREF>
                            <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/AppPackage/SWC_DriverInput/Pp_Pedal</PORT-PROTOTYPE-REF>
                            <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/AppPackage/IF_Pedal/Element_Throttle</TARGET-DATA-PROTOTYPE-REF>
                          </AUTOSAR-VARIABLE-IREF>
                        </ACCESSED-VARIABLE>
                      </VARIABLE-ACCESS>
                      <VARIABLE-ACCESS>
                        <SHORT-NAME>DSP_Pedal_Brake</SHORT-NAME>
