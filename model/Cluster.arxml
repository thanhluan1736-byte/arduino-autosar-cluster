                            <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/AppPackage/SWC_DriverInput/Pp_ButtonEvent</PORT-PROTOTYPE-REF>
                            <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/AppPackage/IF_ButtonEvent/Element_Seq</TARGET-DATA-PROTOTYPE-REF>
                          </AUTOSAR-VARIABLE-IREF>
                        </ACCESSED-VARIABLE>
                      </VARIABLE-ACCESS>
                  </DATA-SEND-POINTS>
                  <SYMBOL>Runnable_DriverInput_10ms</SYMBOL>
                </RUNNABLE-ENTITY>
              </RUNNABLES>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>

