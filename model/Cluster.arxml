                            <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/AppPackage/IF_Pedal/Element_Brake</TARGET-DATA-PROTOTYPE-REF>
                          </AUTOSAR-VARIABLE-IREF>
                        </ACCESSED-VARIABLE>
                      </VARIABLE-ACCESS>
                      <VARIABLE-ACCESS>
                        <SHORT-NAME>DSP_ButtonEvent_Event</SHORT-NAME>
