          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>

        <!-- ===== SWC_Display ===== -->
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>SWC_Display</SHORT-NAME>
          <PORTS>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>Rp_Distance</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/AppPackage/IF_Distance</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>Rp_ButtonEvent</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/AppPackage/IF_ButtonEvent</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>Pp_TripReset</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/AppPackage/IF_TripReset</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>Rp_SpeedDisplay</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/AppPackage/IF_VehicleSpeed</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>IB_SWC_Display</SHORT-NAME>
              <EVENTS>
                <TIMING-EVENT>
                  <SHORT-NAME>TE_Display_100ms</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/AppPackage/SWC_Display/IB_SWC_Display/Runnable_Display_100ms</START-ON-EVENT-REF>
                  <PERIOD>0.1</PERIOD>
                </TIMING-EVENT>
              </EVENTS>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>Runnable_Display_100ms</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <DATA-RECEIVE-POINT-BY-ARGUMENTS>
                      <VARIABLE-ACCESS>
                        <SHORT-NAME>DRP_Distance_Odo</SHORT-NAME>
                        <ACCESSED-VARIABLE>
                          <AUTOSAR-VARIABLE-IREF>
                            <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/AppPackage/SWC_Display/Rp_Distance</PORT-PROTOTYPE-REF>
                            <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/AppPackage/IF_Distance/Element_Odo</TARGET-DATA-PROTOTYPE-REF>
                          </AUTOSAR-VARIABLE-IREF>
                        </ACCESSED-VARIABLE>
                      </VARIABLE-ACCESS>
                      <VARIABLE-ACCESS>
                        <SHORT-NAME>DRP_Distance_Trip</SHORT-NAME>
                        <ACCESSED-VARIABLE>
                          <AUTOSAR-VARIABLE-IREF>
                            <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/AppPackage/SWC_Display/Rp_Distance</PORT-PROTOTYPE-REF>
                            <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/AppPackage/IF_Distance/Element_Trip</TARGET-DATA-PROTOTYPE-REF>
                          </AUTOSAR-VARIABLE-IREF>
                        </ACCESSED-VARIABLE>
                      </VARIABLE-ACCESS>
                      <VARIABLE-ACCESS>
                        <SHORT-NAME>DRP_Distance_NvStatus</SHORT-NAME>
                        <ACCESSED-VARIABLE>
                          <AUTOSAR-VARIABLE-IREF>
                            <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/AppPackage/SWC_Display/Rp_Distance</PORT-PROTOTYPE-REF>
                            <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/AppPackage/IF_Distance/Element_NvStatus</TARGET-DATA-PROTOTYPE-REF>
                          </AUTOSAR-VARIABLE-IREF>
                        </ACCESSED-VARIABLE>
                      </VARIABLE-ACCESS>
                      <VARIABLE-ACCESS>
                        <SHORT-NAME>DRP_ButtonEvent_Event</SHORT-NAME>
                        <ACCESSED-VARIABLE>
                          <AUTOSAR-VARIABLE-IREF>
                            <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/AppPackage/SWC_Display/Rp_ButtonEvent</PORT-PROTOTYPE-REF>
                            <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/AppPackage/IF_ButtonEvent/Element_Event</TARGET-DATA-PROTOTYPE-REF>
                          </AUTOSAR-VARIABLE-IREF>
                        </ACCESSED-VARIABLE>
                      </VARIABLE-ACCESS>
                      <VARIABLE-ACCESS>
                        <SHORT-NAME>DRP_ButtonEvent_Seq</SHORT-NAME>
                        <ACCESSED-VARIABLE>
                          <AUTOSAR-VARIABLE-IREF>
                            <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/AppPackage/SWC_Display/Rp_ButtonEvent</PORT-PROTOTYPE-REF>
                            <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/AppPackage/IF_ButtonEvent/Element_Seq</TARGET-DATA-PROTOTYPE-REF>
                          </AUTOSAR-VARIABLE-IREF>
                        </ACCESSED-VARIABLE>
                      </VARIABLE-ACCESS>
                      <VARIABLE-ACCESS>
                        <SHORT-NAME>DRP_SpeedDisplay_Speed</SHORT-NAME>
                        <ACCESSED-VARIABLE>
                          <AUTOSAR-VARIABLE-IREF>
                            <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/AppPackage/SWC_Display/Rp_SpeedDisplay</PORT-PROTOTYPE-REF>
                            <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/AppPackage/IF_VehicleSpeed/Element_Speed</TARGET-DATA-PROTOTYPE-REF>
                          </AUTOSAR-VARIABLE-IREF>
                        </ACCESSED-VARIABLE>
                      </VARIABLE-ACCESS>
                  </DATA-RECEIVE-POINT-BY-ARGUMENTS>
                  <DATA-SEND-POINTS>
                      <VARIABLE-ACCESS>
                        <SHORT-NAME>DSP_TripReset_ReqSeq</SHORT-NAME>
                        <ACCESSED-VARIABLE>
                          <AUTOSAR-VARIABLE-IREF>
                            <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/AppPackage/SWC_Display/Pp_TripReset</PORT-PROTOTYPE-REF>
                            <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/AppPackage/IF_TripReset/Element_ReqSeq</TARGET-DATA-PROTOTYPE-REF>
                          </AUTOSAR-VARIABLE-IREF>
                        </ACCESSED-VARIABLE>
                      </VARIABLE-ACCESS>
                      <VARIABLE-ACCESS>
                        <SHORT-NAME>DSP_TripReset_OdoReqSeq</SHORT-NAME>
                        <ACCESSED-VARIABLE>
                          <AUTOSAR-VARIABLE-IREF>
                            <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/AppPackage/SWC_Display/Pp_TripReset</PORT-PROTOTYPE-REF>
                            <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/AppPackage/IF_TripReset/Element_OdoReqSeq</TARGET-DATA-PROTOTYPE-REF>
                          </AUTOSAR-VARIABLE-IREF>
                        </ACCESSED-VARIABLE>
                      </VARIABLE-ACCESS>
                  </DATA-SEND-POINTS>
                  <SYMBOL>Runnable_Display_100ms</SYMBOL>
                </RUNNABLE-ENTITY>
              </RUNNABLES>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>

