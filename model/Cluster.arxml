            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>

        <!-- ===== SWC_DriverInput ===== -->
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>SWC_DriverInput</SHORT-NAME>
          <PORTS>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>Pp_Pedal</SHORT-NAME>
