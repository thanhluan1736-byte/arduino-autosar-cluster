            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>Element_Trip</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AppPackage/dt_uint32</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
            <VARIABLE-DATA-PROTOTYPE>
